@echo off
set "COB_MAIN_DIR=C:\GnuCOBOL\"
set "PATH=%COB_MAIN_DIR%bin;%PATH%"
set "COB_CONFIG_DIR=%COB_MAIN_DIR%config"
set "COB_COPY_DIR=%COB_MAIN_DIR%copy"
echo Building B+ Tree Engine...
cobc -free -x -Wall -Icopybooks src\btree_engine.cbl -o btree_engine.exe
echo Building B+ Tree Test...
cobc -free -x -Wall -Icopybooks tests\btree_test.cbl -o btree_test.exe
echo Building WAL Test...
cobc -free -x -Wall -Icopybooks tests\btree_wal_test.cbl src\btree_wal_logger.cbl -o btree_wal_test.exe
echo Building Cursor Test...
cobc -free -x -Wall -Icopybooks tests\btree_cursor_test.cbl src\btree_cursor.cbl -o btree_cursor_test.exe
echo Building Compact Test...
cobc -free -x -Wall -Icopybooks tests\btree_compact_test.cbl src\btree_compact.cbl -o btree_compact_test.exe
echo Building MVCC Test...
cobc -free -x -Wall -Icopybooks tests\btree_mvcc_test.cbl src\btree_mvcc.cbl -o btree_mvcc_test.exe
echo Building Bloom Filter Test...
cobc -free -x -Wall -Icopybooks tests\btree_bloom_test.cbl src\btree_bloom_filter.cbl -o btree_bloom_test.exe
echo Building Lock Manager Test...
cobc -free -x -Wall -Icopybooks tests\btree_lock_test.cbl src\btree_lock_manager.cbl -o btree_lock_test.exe
echo Building Secondary Index Test...
cobc -free -x -Wall -Icopybooks tests\btree_sec_idx_test.cbl src\btree_secondary_idx.cbl -o btree_sec_idx_test.exe
echo Building Buffer Pool Test...
