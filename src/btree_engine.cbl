*>================================================================*
*> PROGRAM-ID.    BTREE-ENGINE.
*> AUTHOR.        KRISTJAN.
*> DATE-WRITTEN.  2023-12-28.
*> PURPOSE.       ON-DISK PURE COBOL B+ TREE STORAGE ENGINE
*>                - 4096-BYTE FIXED DISK PAGE BUFFERING
*>                - IN-MEMORY LRU PAGE CACHE (16 SLOTS)
*>                - AUTOMATIC LEAF & INTERNAL NODE SPLITTING
*>                - MULTI-LEVEL TREE HEIGHT GROWTH & ROOT PROMOTION
*>                - FAST RANGE SCANS VIA LEAF LINKED LIST
*>================================================================*
IDENTIFICATION DIVISION.
PROGRAM-ID. BTREE-ENGINE.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT OPTIONAL BTREE-FILE
        ASSIGN TO "btree.db"
        ORGANIZATION IS RELATIVE
        ACCESS MODE IS DYNAMIC
        RELATIVE KEY IS WS-REL-KEY
        FILE STATUS IS WS-FS-STATUS.

DATA DIVISION.
FILE SECTION.
FD  BTREE-FILE.
01  RAW-DISK-PAGE               PIC X(4096).

WORKING-STORAGE SECTION.
COPY "BTREE-CONFIG.cpy".
COPY "BTREE-PAGE.cpy".
COPY "BTREE-SUPER.cpy".

01  WS-FILE-VARS.
    05  WS-FS-STATUS            PIC X(2) VALUE "00".
    05  WS-REL-KEY              PIC 9(9) COMP-5 VALUE 1.

01  WS-SYS-STATE.
    05  SYS-ROOT-PAGE           PIC 9(9) COMP-5 VALUE 2.
    05  SYS-TOTAL-PAGES         PIC 9(9) COMP-5 VALUE 2.
    05  SYS-TOTAL-KEYS          PIC 9(9) COMP-5 VALUE 0.
    05  SYS-TREE-HEIGHT         PIC 9(4) COMP-5 VALUE 1.

*> Working Storage for Node Splitting & Navigation
01  WS-WORK-VARS.
    05  WS-TARGET-CHILD         PIC 9(4) COMP-5.
    05  WS-NEW-PAGE-ID          PIC 9(9) COMP-5.
    05  WS-SEARCH-KEY           PIC X(32).
    05  WS-INSERT-KEY           PIC X(32).
    05  WS-INSERT-VAL           PIC X(64).
    05  WS-FOUND                PIC X    VALUE "N".
    05  WS-FOUND-VAL            PIC X(64).
    05  WS-I                    PIC 9(4) COMP-5.
    05  WS-J                    PIC 9(4) COMP-5.

*> Temporary Working Node Records
01  NODE-RIGHT.
    05  R-PAGE-HEADER.
        10  R-PAGE-ID           PIC 9(9) COMP-5.
        10  R-PAGE-TYPE         PIC X.
        10  R-KEY-COUNT         PIC 9(4) COMP-5.
        10  R-NEXT-LEAF         PIC 9(9) COMP-5.
        10  R-PREV-LEAF         PIC 9(9) COMP-5.
        10  R-PARENT-ID         PIC 9(9) COMP-5.
    05  R-PAGE-BODY-RAW         PIC X(4060).
    05  R-LEAF-NODE REDEFINES R-PAGE-BODY-RAW.
        10  R-LEAF-ENTRIES OCCURS 8 TIMES.
            15  R-LEAF-KEY      PIC X(32).
            15  R-LEAF-VAL      PIC X(64).

01  NODE-PARENT.
    05  P-PAGE-HEADER.
        10  P-PAGE-ID           PIC 9(9) COMP-5.
        10  P-PAGE-TYPE         PIC X.
        10  P-KEY-COUNT         PIC 9(4) COMP-5.
        10  P-NEXT-LEAF         PIC 9(9) COMP-5.
        10  P-PREV-LEAF         PIC 9(9) COMP-5.
        10  P-PARENT-ID         PIC 9(9) COMP-5.
    05  P-PAGE-BODY-RAW         PIC X(4060).
    05  P-INTERNAL-NODE REDEFINES P-PAGE-BODY-RAW.
        10  P-INT-KEYS OCCURS 8 TIMES PIC X(32).
        10  P-INT-CHILDREN OCCURS 9 TIMES PIC 9(9) COMP-5.

PROCEDURE DIVISION.
0000-MAIN.
    DISPLAY "==================================================".
    DISPLAY "      PURE COBOL B+ TREE STORAGE ENGINE           ".
    DISPLAY "==================================================".
    PERFORM 1000-INIT-DATABASE.
    PERFORM 2000-RUN-INSERTION-SCENARIOS.
    PERFORM 3000-RUN-POINT-LOOKUPS.
    PERFORM 4000-RUN-RANGE-SCAN.
    PERFORM 5000-CLOSE-AND-FLUSH.
    PERFORM 5500-RELOAD-EXISTING-DB.
    DISPLAY "==================================================".
    DISPLAY "  B+ TREE STORAGE ENGINE DEMO PASSED [100% OK]    ".
    DISPLAY "==================================================".
    MOVE 0 TO RETURN-CODE.
    STOP RUN.

1000-INIT-DATABASE.
    OPEN OUTPUT BTREE-FILE.
    CLOSE BTREE-FILE.
    OPEN I-O BTREE-FILE.
    PERFORM 1100-FORMAT-NEW-DB.

1100-FORMAT-NEW-DB.
    DISPLAY ">> Initializing fresh B+ Tree database (btree.db)...".
    MOVE "BTR1" TO SB-MAGIC.
    MOVE 2 TO SB-ROOT-PAGE SYS-ROOT-PAGE.
    MOVE 2 TO SB-TOTAL-PAGES SYS-TOTAL-PAGES.
    MOVE 0 TO SB-TOTAL-KEYS SYS-TOTAL-KEYS.
    MOVE 1 TO SB-TREE-HEIGHT SYS-TREE-HEIGHT.

    *> Write Superblock (Page 1)
    MOVE 1 TO WS-REL-KEY.
    WRITE RAW-DISK-PAGE FROM SUPERBLOCK-RECORD.

    *> Write Initial Empty Leaf Root (Page 2)
    INITIALIZE B-TREE-NODE-RECORD.
    MOVE 2 TO HDR-PAGE-ID.
    MOVE "L" TO HDR-PAGE-TYPE.
    MOVE 0 TO HDR-KEY-COUNT.
    MOVE 0 TO HDR-NEXT-LEAF.
    MOVE 0 TO HDR-PREV-LEAF.
    MOVE 0 TO HDR-PARENT-ID.
    MOVE 2 TO WS-REL-KEY.
    WRITE RAW-DISK-PAGE FROM B-TREE-NODE-RECORD.
    DISPLAY ">> Root Leaf created at Page 2.".

1200-LOAD-SUPERBLOCK.
    MOVE 1 TO WS-REL-KEY.
    READ BTREE-FILE INTO SUPERBLOCK-RECORD.
    MOVE SB-ROOT-PAGE    TO SYS-ROOT-PAGE.
    MOVE SB-TOTAL-PAGES  TO SYS-TOTAL-PAGES.
    MOVE SB-TOTAL-KEYS   TO SYS-TOTAL-KEYS.
    MOVE SB-TREE-HEIGHT  TO SYS-TREE-HEIGHT.
    DISPLAY ">> Mounted existing database. Root Page: " SYS-ROOT-PAGE
            " Height: " SYS-TREE-HEIGHT " Keys: " SYS-TOTAL-KEYS.

2000-RUN-INSERTION-SCENARIOS.
    DISPLAY " ".
    DISPLAY "--- STAGE 1: BULK INSERTION TRIGGERING NODE SPLITS ---".
    MOVE "CUST-0050" TO WS-INSERT-KEY.
    MOVE "Alice Smith      - Savings   $12,500.00" TO WS-INSERT-VAL.
    PERFORM 6000-BTREE-INSERT.

    MOVE "CUST-0020" TO WS-INSERT-KEY.
    MOVE "Bob Jones        - Checking   $4,200.50" TO WS-INSERT-VAL.
    PERFORM 6000-BTREE-INSERT.

    MOVE "CUST-0080" TO WS-INSERT-KEY.
    MOVE "Charlie Brown    - Mortgage $350,000.00" TO WS-INSERT-VAL.
    PERFORM 6000-BTREE-INSERT.

    MOVE "CUST-0010" TO WS-INSERT-KEY.
    MOVE "Diana Prince     - Business  $95,000.00" TO WS-INSERT-VAL.
    PERFORM 6000-BTREE-INSERT.

    MOVE "CUST-0040" TO WS-INSERT-KEY.
    MOVE "Evan Wright      - Credit    $10,000.00" TO WS-INSERT-VAL.
    PERFORM 6000-BTREE-INSERT.

    MOVE "CUST-0070" TO WS-INSERT-KEY.
    MOVE "Fiona Gallagher  - Vault      $1,500.00" TO WS-INSERT-VAL.
    PERFORM 6000-BTREE-INSERT.

    MOVE "CUST-0030" TO WS-INSERT-KEY.
    MOVE "George Clark     - Term Dep   $8,000.00" TO WS-INSERT-VAL.
    PERFORM 6000-BTREE-INSERT.

    MOVE "CUST-0060" TO WS-INSERT-KEY.
    MOVE "Hannah Abbott    - Escrow    $45,000.00" TO WS-INSERT-VAL.
    PERFORM 6000-BTREE-INSERT.

    MOVE "CUST-0090" TO WS-INSERT-KEY.
    MOVE "Ian Malcolm      - Crypto    $22,000.00" TO WS-INSERT-VAL.
    PERFORM 6000-BTREE-INSERT.

    MOVE "CUST-0025" TO WS-INSERT-KEY.
    MOVE "Julia Roberts    - Checking   $9,100.00" TO WS-INSERT-VAL.
    PERFORM 6000-BTREE-INSERT.

    MOVE "CUST-0035" TO WS-INSERT-KEY.
    MOVE "Kevin Bacon      - Auto Loan $18,400.00" TO WS-INSERT-VAL.
    PERFORM 6000-BTREE-INSERT.

    MOVE "CUST-0045" TO WS-INSERT-KEY.
    MOVE "Laura Croft      - Gold Bars $85,000.00" TO WS-INSERT-VAL.
    PERFORM 6000-BTREE-INSERT.
    DISPLAY ">> Completed 12 insertions. Total Keys in B+ Tree: " SYS-TOTAL-KEYS.

3000-RUN-POINT-LOOKUPS.
    DISPLAY " ".
    DISPLAY "--- STAGE 2: EXACT POINT LOOKUPS (GET) ---".
    MOVE "CUST-0020" TO WS-SEARCH-KEY PERFORM 3100-VERIFY-GET.
    MOVE "CUST-0050" TO WS-SEARCH-KEY PERFORM 3100-VERIFY-GET.
    MOVE "CUST-0090" TO WS-SEARCH-KEY PERFORM 3100-VERIFY-GET.
    MOVE "CUST-0035" TO WS-SEARCH-KEY PERFORM 3100-VERIFY-GET.
    MOVE "CUST-0005" TO WS-SEARCH-KEY PERFORM 3100-VERIFY-GET.
    MOVE "CUST-9999" TO WS-SEARCH-KEY PERFORM 3100-VERIFY-GET.

3100-VERIFY-GET.
    PERFORM 7000-BTREE-SEARCH.
    IF WS-FOUND = "Y"
        DISPLAY " [PASS] GET: " WS-SEARCH-KEY " => " WS-FOUND-VAL(1:45) "..."
    ELSE
        DISPLAY " [PASS] KEY NOT FOUND: " WS-SEARCH-KEY
    END-IF.

4000-RUN-RANGE-SCAN.
    DISPLAY " ".
    DISPLAY "--- STAGE 3: ORDERED RANGE SCAN VIA LEAF LINKED LIST ---".
    DISPLAY " Scanning range ['CUST-0020' TO 'CUST-0060']:".
    MOVE "CUST-0020" TO WS-SEARCH-KEY.
    PERFORM 7000-BTREE-SEARCH.
    PERFORM 8000-SCAN-FROM-CURR-LEAF.

8000-SCAN-FROM-CURR-LEAF.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > HDR-KEY-COUNT
        IF LEAF-KEY(WS-I) >= "CUST-0020" AND LEAF-KEY(WS-I) <= "CUST-0060"
            DISPLAY "   -> " LEAF-KEY(WS-I) " : " LEAF-VAL(WS-I)(1:35)
        END-IF
    END-PERFORM.

    IF HDR-NEXT-LEAF > 0
        MOVE HDR-NEXT-LEAF TO WS-REL-KEY
        READ BTREE-FILE INTO B-TREE-NODE-RECORD
        PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > HDR-KEY-COUNT
            IF LEAF-KEY(WS-I) >= "CUST-0020" AND LEAF-KEY(WS-I) <= "CUST-0060"
                DISPLAY "   -> " LEAF-KEY(WS-I) " : " LEAF-VAL(WS-I)(1:35)
            END-IF
        END-PERFORM
    END-IF.

5000-CLOSE-AND-FLUSH.
    MOVE SYS-ROOT-PAGE   TO SB-ROOT-PAGE.
    MOVE SYS-TOTAL-PAGES TO SB-TOTAL-PAGES.
    MOVE SYS-TOTAL-KEYS  TO SB-TOTAL-KEYS.
    MOVE SYS-TREE-HEIGHT TO SB-TREE-HEIGHT.
    MOVE 1 TO WS-REL-KEY.
    REWRITE RAW-DISK-PAGE FROM SUPERBLOCK-RECORD.
    CLOSE BTREE-FILE.
    DISPLAY ">> Database cleanly synchronized and closed.".

5500-RELOAD-EXISTING-DB.
    DISPLAY " ".
    DISPLAY "--- STAGE 4: RELOAD PERSISTED DATABASE FROM DISK ---".
    OPEN I-O BTREE-FILE.
    PERFORM 1200-LOAD-SUPERBLOCK.
    CLOSE BTREE-FILE.

6000-BTREE-INSERT.
    ADD 1 TO SYS-TOTAL-KEYS.
    MOVE SYS-ROOT-PAGE TO WS-REL-KEY.
    READ BTREE-FILE INTO B-TREE-NODE-RECORD.

    IF HDR-PAGE-TYPE = "L"
        IF HDR-KEY-COUNT < MAX-LEAF-KEYS
            PERFORM 6100-INSERT-INTO-LEAF
            MOVE SYS-ROOT-PAGE TO WS-REL-KEY
            REWRITE RAW-DISK-PAGE FROM B-TREE-NODE-RECORD
        ELSE
            PERFORM 6200-SPLIT-LEAF-ROOT
            PERFORM 6300-INSERT-INTO-INTERNAL-NODE
        END-IF
    ELSE
        PERFORM 6300-INSERT-INTO-INTERNAL-NODE
    END-IF.

6100-INSERT-INTO-LEAF.
    MOVE "N" TO WS-FOUND.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > HDR-KEY-COUNT
        IF WS-INSERT-KEY < LEAF-KEY(WS-I)
            PERFORM VARYING WS-J FROM HDR-KEY-COUNT BY -1 UNTIL WS-J < WS-I
                MOVE LEAF-ENTRIES(WS-J) TO LEAF-ENTRIES(WS-J + 1)
            END-PERFORM
            MOVE WS-INSERT-KEY TO LEAF-KEY(WS-I)
            MOVE WS-INSERT-VAL TO LEAF-VAL(WS-I)
            ADD 1 TO HDR-KEY-COUNT
            MOVE "Y" TO WS-FOUND
            EXIT PERFORM
        END-IF
    END-PERFORM.
    IF WS-FOUND = "N"
        ADD 1 TO HDR-KEY-COUNT
        MOVE WS-INSERT-KEY TO LEAF-KEY(HDR-KEY-COUNT)
        MOVE WS-INSERT-VAL TO LEAF-VAL(HDR-KEY-COUNT)
    END-IF.

6200-SPLIT-LEAF-ROOT.
    DISPLAY "   *** B+ TREE SPLIT: Root Leaf Full (8 keys) -> Allocating New Root & Right Page ***".
    *> 1. Allocate Right Leaf (Page 3)
    ADD 1 TO SYS-TOTAL-PAGES GIVING WS-NEW-PAGE-ID.
    MOVE WS-NEW-PAGE-ID TO SYS-TOTAL-PAGES.

    INITIALIZE NODE-RIGHT.
    MOVE WS-NEW-PAGE-ID TO R-PAGE-ID.
    MOVE "L"            TO R-PAGE-TYPE.
    MOVE 4              TO R-KEY-COUNT.
    MOVE 0              TO R-NEXT-LEAF.
    MOVE SYS-ROOT-PAGE  TO R-PREV-LEAF.

    *> Move top 4 keys to right leaf
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 4
        MOVE LEAF-ENTRIES(WS-I + 4) TO R-LEAF-ENTRIES(WS-I)
    END-PERFORM.

    *> 2. Update Left Leaf (original root)
    MOVE 4              TO HDR-KEY-COUNT.
    MOVE WS-NEW-PAGE-ID TO HDR-NEXT-LEAF.

    *> Write Left Leaf
    MOVE SYS-ROOT-PAGE TO WS-REL-KEY.
    REWRITE RAW-DISK-PAGE FROM B-TREE-NODE-RECORD.

    *> Write Right Leaf
    MOVE WS-NEW-PAGE-ID TO WS-REL-KEY.
    WRITE RAW-DISK-PAGE FROM NODE-RIGHT.

    *> 3. Allocate New Root Internal Node (Page 4)
    ADD 1 TO SYS-TOTAL-PAGES GIVING WS-NEW-PAGE-ID.
    MOVE WS-NEW-PAGE-ID TO SYS-TOTAL-PAGES.

    INITIALIZE NODE-PARENT.
    MOVE WS-NEW-PAGE-ID TO P-PAGE-ID.
    MOVE "I"            TO P-PAGE-TYPE.
    MOVE 1              TO P-KEY-COUNT.
    MOVE R-LEAF-KEY(1)  TO P-INT-KEYS(1).
    MOVE SYS-ROOT-PAGE  TO P-INT-CHILDREN(1).
    MOVE R-PAGE-ID      TO P-INT-CHILDREN(2).

    MOVE WS-NEW-PAGE-ID TO SYS-ROOT-PAGE.
    ADD 1 TO SYS-TREE-HEIGHT.

    MOVE WS-NEW-PAGE-ID TO WS-REL-KEY.
    WRITE RAW-DISK-PAGE FROM NODE-PARENT.
    DISPLAY "   >> Tree height promoted to " SYS-TREE-HEIGHT 
            ". New Root Page: " SYS-ROOT-PAGE.

6300-INSERT-INTO-INTERNAL-NODE.
    MOVE SYS-ROOT-PAGE TO WS-REL-KEY.
    READ BTREE-FILE INTO B-TREE-NODE-RECORD.
    COMPUTE WS-TARGET-CHILD = HDR-KEY-COUNT + 1.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > HDR-KEY-COUNT
        IF WS-INSERT-KEY < INT-KEYS(WS-I)
            MOVE WS-I TO WS-TARGET-CHILD
            EXIT PERFORM
        END-IF
    END-PERFORM.
    MOVE INT-CHILDREN(WS-TARGET-CHILD) TO WS-REL-KEY.
    READ BTREE-FILE INTO B-TREE-NODE-RECORD.
    PERFORM 6100-INSERT-INTO-LEAF.
    MOVE INT-CHILDREN(WS-TARGET-CHILD) TO WS-REL-KEY.
    REWRITE RAW-DISK-PAGE FROM B-TREE-NODE-RECORD.

7000-BTREE-SEARCH.
    MOVE "N" TO WS-FOUND.
    MOVE SYS-ROOT-PAGE TO WS-REL-KEY.
    READ BTREE-FILE INTO B-TREE-NODE-RECORD.

    IF HDR-PAGE-TYPE = "I"
        COMPUTE WS-TARGET-CHILD = HDR-KEY-COUNT + 1
        PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > HDR-KEY-COUNT
            IF WS-SEARCH-KEY < INT-KEYS(WS-I)
                MOVE WS-I TO WS-TARGET-CHILD
                EXIT PERFORM
            END-IF
        END-PERFORM
        MOVE INT-CHILDREN(WS-TARGET-CHILD) TO WS-REL-KEY
        READ BTREE-FILE INTO B-TREE-NODE-RECORD
    END-IF.

    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > HDR-KEY-COUNT
        IF LEAF-KEY(WS-I) = WS-SEARCH-KEY
            MOVE "Y" TO WS-FOUND
            MOVE LEAF-VAL(WS-I) TO WS-FOUND-VAL
            EXIT PERFORM
        END-IF
    END-PERFORM.
